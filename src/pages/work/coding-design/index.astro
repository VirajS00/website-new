---
import Layout from "../../../components/Layout/Layout.astro";
import codingData from "../../../../data/coding_design.json";

const GithubIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>`;

const CodepenIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"></polygon><line x1="12" y1="22" x2="12" y2="15.5"></line><polyline points="22 8.5 12 15.5 2 8.5"></polyline><polyline points="2 15.5 12 8.5 22 15.5"></polyline><line x1="12" y1="2" x2="12" y2="8.5"></line></svg>`;

const ExternalLinkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>`;
---

<Layout
  title="Viraj's Website | Coding & Design"
  description="My coding and design projects"
>
  <main class="coding-page">
    <h1 class="page-title">CODING & DESIGN</h1>

    <div class="projects-grid">
      {
        codingData.data.map((project) => (
          <article class="project-card">
            <a
              href={project.project_link}
              target="_blank"
              rel="noopener noreferrer"
              class="image-wrapper"
            >
              <img
                src={project.img}
                alt={project.title}
                loading="lazy"
                class="project-img"
              />
            </a>

            <div class="card-content">
              <h2 class="project-title">{project.title}</h2>
              <p class="project-desc">{project.very_short_desc}</p>

              <div class="links-row">
                {project.github_link && (
                  <a
                    href={project.github_link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`GitHub Repository for ${project.title}`}
                    class="icon-link"
                    set:html={GithubIcon}
                  />
                )}
                {project.codepen_link && (
                  <a
                    href={project.codepen_link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`CodePen for ${project.title}`}
                    class="icon-link"
                    set:html={CodepenIcon}
                  />
                )}
                {project.project_link && !project.codepen_link && (
                  <a
                    href={project.project_link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Live Project of ${project.title}`}
                    class="icon-link"
                    set:html={ExternalLinkIcon}
                  />
                )}
              </div>

              <div class="tools-row">
                {project.tools_used.map((tool) => (
                  <span class="tool-badge">{tool}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </main>
</Layout>

<style>
  .coding-page {
    padding-block-start: 3rem;
    padding-block-end: 5rem;
  }

  .page-title {
    font-size: clamp(3rem, 8vw, 5rem);
    margin: 0 0 4rem 0;
    text-shadow: 6px 6px 0px #cccccc;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 3rem;

    @media screen and (max-width: 465px) {
      grid-template-columns: 1fr;
    }
  }

  .project-card {
    background-color: #fff;
    border: 4px solid #000;
    box-shadow: 8px 8px 0 #000;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .image-wrapper {
    display: block;
    width: 100%;
    border-bottom: 4px solid #000;
    overflow: hidden;
  }

  .project-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    background-color: #f4f4f5;
    transition: transform 0.3s ease;
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.75rem 0;
  }

  .project-desc {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #666;
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
    font-family: inherit;
  }

  .links-row {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #000;
    transition: transform 0.15s ease;
  }

  .icon-link:hover {
    transform: scale(1.15) rotate(-5deg);
  }

  .icon-link :global(svg) {
    width: 28px;
    height: 28px;
  }

  .tools-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tool-badge {
    background-color: #b4c4ff;
    border: 2px solid #000;
    padding: 0.3rem 0.6rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    color: #000;
    box-shadow: 2px 2px 0 #000;
  }
</style>
