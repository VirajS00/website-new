---
import Button from "../../components/Button/Button.astro";
import Layout from "../../components/Layout/Layout.astro";
---

<Layout
  title="Viraj's Website | Work"
  description="Work Section of Viraj Shukla's website"
>
  <section class="container">
    <h1>MY WORK</h1>
    <div class="cards-container">
      <div class="card">
        <img src="/camera-red.svg" class="card-image" />
        <div class="card-inner">
          <h2>Photography</h2>
          <p>
            I started doing photography when I was very young, developing a
            passion for nature and macro photography.
          </p>
          <Button href="/work/photography">Check out my Photos</Button>
        </div>
      </div>
      <div class="card">
        <img src="/filmmaking-logo.svg" class="card-image" />
        <div class="card-inner">
          <h2>Filmmaking</h2>
          <p>
            I've explored filmmaking from an early age and studied it in
            college. creating documentary projects.
          </p>
          <Button href="/work/filmmaking" color="green"
            >Check out my Video Work</Button
          >
        </div>
      </div>
      <div class="card">
        <img src="/coding-design-logo.svg" class="card-image" />
        <div class="card-inner">
          <h2>Code & Design</h2>
          <p>
            Blending code and creative design to build unique digital
            experiences from the ground up.
          </p>
          <Button href="/work/coding-design" color="blue"
            >Check out my Code & Design Work</Button
          >
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container {
    margin-inline: auto;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    text-shadow: 0.05em 0.05em 0 rgb(0 0 0 / 0.25);
  }

  .card-image {
    width: 100%;
    height: auto;
  }

  .cards-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(375px, 100%), 1fr));
    gap: clamp(2rem, 4vw, 5rem);
  }

  .card {
    background-color: #fff;
    border: 2px solid #000;
    box-shadow: 6px 6px 0 #000;
    display: grid;
    grid-template-rows: 1fr auto;
  }

  .card-inner {
    padding: 1rem;
  }

  h2 {
    margin-block-start: 0;
    margin-block-end: 0.5rem;
  }

  p {
    margin-block-start: 0;
    margin-block-end: 1.75rem;
  }
</style>
