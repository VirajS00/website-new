---
// Photo Editing Pipeline Diagram Component
---

<div class="pipeline-wrapper">
  <!-- Top Node -->
  <div class="box main-box raw-box">RAW FILE INPUT (EOS 80D)</div>

  <!-- Top Split -->
  <div class="split-lines desktop-only">
    <div class="vertical-line left-line"></div>
    <div class="vertical-line center-top-line"></div>
    <div class="vertical-line right-line"></div>
  </div>
  <div class="arrow mobile-only">↓</div>

  <div class="paths-container">
    <!-- PIPELINE A (Left) -->
    <div class="path">
      <div class="box header-box path-a-header">
        <strong>PIPELINE A: EXIF-ENABLED GLASS</strong>
        <span class="subtext">(Wildlife - Canon EF 100-400mm)</span>
      </div>

      <div class="arrow">↓</div>

      <div class="box tool-box">
        <h3>DxO PhotoLab 9.6</h3>
        <ul>
          <li>DeepPRIME XD Noise Reduction</li>
          <li>Camera/Lens Profile Demosaicing</li>
        </ul>
      </div>

      <!-- Stretches to match the height of Pipeline B -->
      <div class="path-filler-line desktop-only"></div>
    </div>

    <div class="arrow mobile-only paths-divider">↓</div>

    <!-- PIPELINE B (Right) -->
    <div class="path">
      <div class="box header-box path-b-header">
        <strong>PIPELINE B: MACRO & MANUAL GEAR</strong>
        <span class="subtext">(Macro - Reversed Pentax, Extension Tubes)</span>
      </div>

      <div class="arrow">↓</div>

      <div class="box tool-box">
        <h3>RawTherapee</h3>
        <ul>
          <li>Adobe LCP Profile (Geometry Correction)</li>
          <li>RCD Demosaicing</li>
          <li>RL Deconvolution (Capture Sharpening)</li>
        </ul>
      </div>

      <div class="arrow">↓</div>
      <div class="badge">16-Bit TIFF Export</div>
      <div class="arrow">↓</div>

      <div class="box tool-box">
        <h3>Affinity Photo</h3>
        <ul>
          <li>16-bit TIFF Focus Stacking</li>
          <li>Dust/Blemish Spot Healing</li>
        </ul>
      </div>

      <div class="arrow">↓</div>
      <div class="badge">16-Bit TIFF Export</div>
      <div class="arrow">↓</div>

      <div class="box tool-box">
        <h3>Topaz Photo AI</h3>
        <ul>
          <li>Targeted Final Denoise/Polish</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Join -->
  <div class="join-lines desktop-only">
    <div class="vertical-line left-line"></div>
    <div class="vertical-line center-bottom-line"></div>
    <div class="vertical-line right-line"></div>
  </div>
  <div class="arrow join-arrow">↓</div>

  <!-- Bottom Node -->
  <div class="box main-box export-box">8-Bit JPEG Export</div>
</div>

<style>
  .pipeline-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 4rem 0;
    font-family: system-ui, sans-serif;
    color: #000;
  }

  .box {
    border: 3px solid #000;
    box-shadow: 6px 6px 0px 0px #000;
    padding: 1.5rem;
    text-align: center;
  }

  .main-box {
    font-size: 1.25rem;
    font-weight: 800;
    background-color: #fef052;
    padding: 1.25rem 2.5rem;
    position: relative;
    z-index: 2;
  }

  .export-box {
    background-color: #22c55e;
  }

  .paths-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    width: 100%;
    max-width: 900px;
    align-items: start;
    position: relative;
    z-index: 1;
  }

  .mobile-only {
    display: none;
  }

  @media (max-width: 768px) {
    .paths-container {
      grid-template-columns: 1fr;
      gap: 1rem; /* reduced gap since we have a divider arrow now */
    }

    .desktop-only {
      display: none !important;
    }

    .mobile-only {
      display: block;
    }

    .arrow.mobile-only {
      display: block;
      text-align: center;
      margin: 1.5rem 0;
    }

    .paths-divider {
      margin: 2rem 0 !important;
    }
  }

  .path {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
  }

  .header-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    color: #fff;
    padding: 1.25rem;
  }

  .path-a-header {
    background-color: #ff2255;
  }
  .path-b-header {
    background-color: #0055ff;
  }

  .subtext {
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0.9;
  }

  .tool-box {
    background-color: #fff4db;
    width: 100%;
    text-align: left;
    transition:
      translate 150ms ease,
      box-shadow 150ms ease;
  }

  .tool-box h3 {
    margin: 0 0 1rem 0;
    font-size: 1.15rem;
    font-weight: 800;
    border-bottom: 3px solid #000;
    padding-bottom: 0.5rem;
  }

  .tool-box ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .tool-box li {
    font-weight: 600;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .tool-box li:last-child {
    margin-bottom: 0;
  }

  .arrow {
    font-size: 1.75rem;
    font-weight: 900;
    line-height: 1;
    margin: 0.75rem 0;
  }

  .join-arrow {
    margin-top: 0;
  }

  .badge {
    background-color: #000;
    color: #fff;
    padding: 0.5rem 1.25rem;
    font-weight: 800;
    font-size: 0.85rem;
    border-radius: 99px;
    box-shadow: 4px 4px 0px 0px #fef052;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .path-filler-line {
    flex-grow: 1;
    width: 4px;
    background-color: #000;
    margin-top: 0.75rem;
    min-height: 2rem;
  }

  /* Structural Connector Lines */
  .split-lines {
    width: calc(50% + 1rem); /* 50% + half of the 2rem gap */
    height: 2rem;
    border-top: 4px solid #000;
    position: relative;
    margin-top: 2rem; /* Drop down from the main box before splitting */
    z-index: 1;
  }

  .join-lines {
    width: calc(50% + 1.25rem);
    height: 2rem;
    border-bottom: 4px solid #000;
    position: relative;
    z-index: 1;
  }

  .vertical-line {
    position: absolute;
    width: 4px;
    background-color: #000;
  }

  .split-lines .center-top-line {
    left: 50%;
    bottom: 100%;
    height: 2rem; /* Connects up to the main box */
    transform: translateX(-50%);
  }

  .split-lines .left-line {
    left: 0;
    top: 0;
    height: 2rem;
  }

  .split-lines .right-line {
    right: 0;
    top: 0;
    height: 2rem;
  }

  .join-lines .left-line {
    left: 0;
    bottom: 0;
    height: 2rem;
  }

  .join-lines .right-line {
    right: 0;
    bottom: 0;
    height: 2rem;
  }

  .join-lines .center-bottom-line {
    left: 50%;
    top: 100%;
    height: 1rem;
    transform: translateX(-50%);
  }
</style>
